# -----------------------------------------------------------------------------
# EVENTEASE ENVIRONMENT VARIABLES CONFIGURATION
# -----------------------------------------------------------------------------

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (Keep private, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Optional Email Notification Provider (e.g. Resend / SendGrid)
# Core app functions smoothly with built-in in-app notification center if email is omitted
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="EventEase <notifications@eventease.college.edu>"
